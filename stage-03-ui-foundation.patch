+  border-radius: 50%;
+  background: var(--color-tile-ink);
+}
+
+.pips span:nth-child(1) {
+  grid-area: 1 / 1;
+}
+
+.pips span:nth-child(2) {
+  grid-area: 1 / 3;
+}
+
+.pips span:nth-child(3) {
+  grid-area: 2 / 2;
+}
+
+.pips span:nth-child(4) {
+  grid-area: 3 / 1;
+}
+
+.pips span:nth-child(5) {
+  grid-area: 3 / 3;
