new file mode 100644
index 0000000..d1b5353
--- /dev/null
+++ b/src/styles/tokens.css
@@ -0,0 +1,173 @@
+/*
+ * Design tokens for Play with Friends.
+ *
+ * Every colour, size and duration used by the UI comes from here. Components
+ * never hard-code values; they read these custom properties. See
+ * docs/DESIGN_SYSTEM.md for the reasoning and the measured contrast ratios.
+ *
+ * Theme: "game night". Dark by default (most party games happen in the
+ * evening, on a phone passed around a dim room), with a warm light theme for
+ * people whose device asks for it. `light-dark()` picks the value that matches
+ * the user's colour-scheme preference.
+ */
+:root {
+  color-scheme: dark light;
+
+  /* ── Colour: surfaces ─────────────────────────────────────────── */
+  --color-bg: light-dark(#fbf7f1, #120f1c);
+  --color-surface: light-dark(#ffffff, #1c1829);
+  --color-surface-raised: light-dark(#f3ede4, #26213a);
+  --color-surface-sunken: light-dark(#f1ebe2, #0d0b15);
+  --color-overlay: light-dark(rgb(30 26 41 / 0.45), rgb(5 4 10 / 0.7));
+
+  /* ── Colour: text ─────────────────────────────────────────────── */
+  --color-text: light-dark(#1e1a29, #f5f2fc);
+  --color-text-muted: light-dark(#575164, #bdb5d1);
+  --color-text-inverse: light-dark(#ffffff, #1f0d05);
+
+  /* ── Colour: lines ────────────────────────────────────────────── */
+  /* Decorative separators (no contrast requirement). */
+  --color-border-subtle: light-dark(#e6ded3, #2f2945);
+  /* Borders that identify a control (inputs, secondary buttons): ≥ 3:1. */
+  --color-border: light-dark(#8c8399, #7a719c);
+
+  /* ── Colour: brand ────────────────────────────────────────────── */
+  /* Primary: warm tangerine. Used for the main action on a screen. */
+  --color-primary: light-dark(#c2410c, #ff8a5c);
+  --color-primary-hover: light-dark(#a8380a, #ff9f78);
+  --color-on-primary: light-dark(#ffffff, #1f0d05);
+  /* Primary as text/icons on normal surfaces. */
+  --color-primary-text: light-dark(#b13a0a, #ffa27f);
+  --color-primary-soft: light-dark(#fde6d9, #3a2230);
+
+  /* Secondary: mint. Used sparingly for highlights and "ready" states. */
+  --color-secondary: light-dark(#0f766e, #5fe0b7);
+  --color-secondary-soft: light-dark(#d5f3ec, #173a35);
+
+  /* ── Colour: status ───────────────────────────────────────────── */
+  --color-success: light-dark(#17773b, #5ee49a);
+  --color-success-soft: light-dark(#dcf3e3, #16352a);
+  --color-warning: light-dark(#8a5300, #ffc94d);
+  --color-warning-soft: light-dark(#fbecd0, #3a2f17);
+  --color-danger: light-dark(#b4232f, #ff7a8e);
+  --color-danger-soft: light-dark(#fbe0e2, #3d1c26);
+  --color-on-danger: light-dark(#ffffff, #1f0509);
+
+  /* ── Colour: focus ────────────────────────────────────────────── */
+  --color-focus: light-dark(#4338ca, #ffd166);
+
+  /* ── Colour: game tiles ───────────────────────────────────────── */
+  /* Seven bright tile colours, assigned by catalogue position. Glyphs on them
+     always use --color-tile-ink (≥ 8:1 on every tile in both themes). */
+  --color-tile-1: #ff9a73;
+  --color-tile-2: #ffd166;
+  --color-tile-3: #6fe3bd;
+  --color-tile-4: #7cc8ff;
+  --color-tile-5: #c0a8ff;
+  --color-tile-6: #ff9fcf;
+  --color-tile-7: #c3ec8f;
+  --color-tile-ink: #1e1a29;
+
+  /* ── Typography ───────────────────────────────────────────────── */
+  /* System fonts only: zero download, native feel on every platform.
+     Headings prefer the rounded system face where one exists (Apple). */
+  --font-body:
+    system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', Ubuntu, Cantarell, 'Helvetica Neue',
+    Arial, sans-serif;
+  --font-display:
+    ui-rounded, 'SF Pro Rounded', 'Nunito', 'Varela Round', system-ui, -apple-system, 'Segoe UI',
+    Roboto, sans-serif;
+  --font-mono: ui-monospace, 'SF Mono', 'Cascadia Mono', 'Roboto Mono', Menlo, Consolas, monospace;
+
+  /* Fluid type scale. Each step is rem + vw, so it grows with the viewport
+     and still scales with browser zoom and the user's text-size setting. */
+  --text-sm: 0.875rem; /* 14px: the smallest size used anywhere */
+  --text-base: clamp(1rem, 0.97rem + 0.15vw, 1.0625rem);
+  --text-lg: clamp(1.125rem, 1.06rem + 0.3vw, 1.25rem);
+  --text-xl: clamp(1.25rem, 1.12rem + 0.6vw, 1.5rem);
+  --text-2xl: clamp(1.5rem, 1.25rem + 1.2vw, 2rem);
+  --text-3xl: clamp(1.875rem, 1.45rem + 2.1vw, 2.75rem);
+  --text-display: clamp(2.375rem, 1.5rem + 4.4vw, 4.75rem);
+
+  --leading-tight: 1.15;
+  --leading-snug: 1.3;
+  --leading-normal: 1.55;
+
+  --weight-regular: 400;
+  --weight-medium: 500;
+  --weight-semibold: 600;
+  --weight-bold: 700;
+  --weight-heavy: 800;
+
+  /* ── Spacing (4px base) ───────────────────────────────────────── */
+  --space-1: 0.25rem;
+  --space-2: 0.5rem;
+  --space-3: 0.75rem;
+  --space-4: 1rem;
+  --space-5: 1.25rem;
+  --space-6: 1.5rem;
+  --space-8: 2rem;
+  --space-10: 2.5rem;
+  --space-12: 3rem;
+  --space-16: 4rem;
+
+  /* Fluid layout spacing. */
+  --gutter: clamp(1rem, 0.6rem + 2vw, 2rem); /* page side padding */
+  --space-section: clamp(3rem, 2rem + 5vw, 6.5rem); /* between landing sections */
+  --space-stack: clamp(1rem, 0.8rem + 1vw, 1.5rem); /* between blocks in a section */
+
+  /* ── Layout ───────────────────────────────────────────────────── */
+  --container-sm: 40rem; /* forms, dialogs, reading text */
+  --container-md: 56rem; /* setup screens, game stage */
+  --container-lg: 74rem; /* landing, catalogue */
+
+  /* Minimum touch target. WCAG 2.2 AA asks for 24px; we use 44px everywhere. */
+  --tap-min: 2.75rem;
+
+  /* ── Shape ────────────────────────────────────────────────────── */
+  --radius-sm: 0.5rem;
+  --radius-md: 0.875rem;
+  --radius-lg: 1.25rem;
+  --radius-xl: 1.75rem;
+  --radius-pill: 999px;
+  --border-width: 1px;
+  --focus-ring-width: 3px;
+
+  /* ── Elevation ────────────────────────────────────────────────── */
+  --shadow-sm: 0 1px 2px light-dark(rgb(30 26 41 / 0.08), rgb(0 0 0 / 0.35));
+  --shadow-md: 0 6px 20px -6px light-dark(rgb(30 26 41 / 0.18), rgb(0 0 0 / 0.55));
+  --shadow-lg: 0 24px 60px -16px light-dark(rgb(30 26 41 / 0.28), rgb(0 0 0 / 0.7));
+
+  /* ── Motion ───────────────────────────────────────────────────── */
+  --duration-fast: 120ms;
+  --duration-base: 200ms;
+  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
+
+  /* ── Layers ───────────────────────────────────────────────────── */
+  --z-header: 10;
+  --z-dropdown: 20;
+  --z-toolbar: 15;
+  --z-tooltip: 30;
+
+  /* ── Safe areas (notches, home indicators, rounded corners) ───── */
+  --safe-top: env(safe-area-inset-top, 0px);
+  --safe-right: env(safe-area-inset-right, 0px);
+  --safe-bottom: env(safe-area-inset-bottom, 0px);
+  --safe-left: env(safe-area-inset-left, 0px);
+}
+
+/* Users who ask for reduced motion get instant state changes. */
+@media (prefers-reduced-motion: reduce) {
+  :root {
+    --duration-fast: 0ms;
+    --duration-base: 0ms;
+  }
+}
+
+/* High-contrast preference: stronger lines and muted text closer to full text. */
+@media (prefers-contrast: more) {
+  :root {
+    --color-border-subtle: var(--color-border);
+    --color-text-muted: var(--color-text);
+  }
+}
