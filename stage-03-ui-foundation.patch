+.shell {
+  display: flex;
+  flex-direction: column;
+  flex: 1 0 auto;
+  min-height: 100vh;
+  min-height: 100dvh;
+}
+
+.titleBlock {
+  min-width: 0;
+  text-align: center;
+  /* Balances the exit button on the left so the title looks centred. */
+  padding-inline-end: var(--space-1);
+}
+
+.title {
+  font-size: var(--text-lg);
+  line-height: var(--leading-tight);
+  /* Long titles wrap onto a second line rather than being cut off. */
+  text-wrap: balance;
+}
+
+@media (min-width: 40rem) {
+  .title {
+    font-size: var(--text-xl);
+  }
+}
+
+.subtitle {
+  color: var(--color-text-muted);
+  font-size: var(--text-sm);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.players {
+  padding-block: var(--space-3);
+  border-bottom: var(--border-width) solid var(--color-border-subtle);
+}
+
+.stage {
+  flex: 1 0 auto;
+  display: flex;
+  flex-direction: column;
+  padding-block: var(--space-stack);
+}
+
+.stage:focus {
+  outline: none;
+}
+
+.stageInner {
+  flex: 1 0 auto;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+}
+
+/* Drag/swipe games: the stage itself never scrolls or zooms the page. */
+.noTouchScroll {
+  touch-action: none;
+  overscroll-behavior: contain;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+.controls {
+  position: sticky;
+  bottom: 0;
+  z-index: var(--z-toolbar);
+  padding: var(--space-3) 0 calc(var(--space-3) + var(--safe-bottom));
+  background: color-mix(in srgb, var(--color-bg) 90%, transparent);
+  border-top: var(--border-width) solid var(--color-border-subtle);
+  /* Taps and double-taps on controls never zoom or bounce the page. */
+  touch-action: manipulation;
+  overscroll-behavior: contain;
+}
+
+@supports (backdrop-filter: blur(1px)) {
+  .controls {
+    backdrop-filter: blur(12px);
+  }
+}
+
+.controlsInner {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: var(--space-3);
