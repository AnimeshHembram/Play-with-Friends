@@ -0,0 +1,364 @@
+/* ── Header nav ──────────────────────────────────────────────── */
+.sectionNav {
+  display: none;
+  gap: var(--space-1);
+  margin-inline-end: var(--space-2);
+}
+
+.sectionNav a {
+  display: inline-flex;
+  align-items: center;
+  min-height: var(--tap-min);
+  padding-inline: var(--space-3);
+  border-radius: var(--radius-pill);
+  color: var(--color-text-muted);
+  font-weight: var(--weight-semibold);
+  text-decoration: none;
+}
+
+.sectionNav a:hover {
+  color: var(--color-text);
+  background: var(--color-surface-raised);
+}
+
+/* Section shortcuts appear once there's room; on phones the page is short
+   enough to scroll, and the header keeps only the brand and Play button. */
+@media (min-width: 48rem) {
+  .sectionNav {
+    display: flex;
+  }
+}
+
+/* ── Hero ────────────────────────────────────────────────────── */
+.hero {
+  padding-block: clamp(var(--space-8), 3rem + 4vw, var(--space-section));
+  overflow: clip;
+}
+
+.heroInner {
+  display: grid;
+  gap: clamp(var(--space-10), 6vw, var(--space-16));
+  align-items: center;
+}
+
+.heroText {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: var(--space-5);
+  min-width: 0;
+}
+
+.heroTitle {
+  font-size: var(--text-display);
+  line-height: 1.08;
+  letter-spacing: -0.03em;
+}
+
+.lead {
+  max-width: 36rem;
+  color: var(--color-text-muted);
+  font-size: var(--text-xl);
+  line-height: var(--leading-snug);
+}
+
+.ctaRow {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-3);
+  margin-top: var(--space-2);
+}
+
+/* Phones: both buttons full width, primary on top — big, easy targets. */
+.ctaRow > * {
+  flex: 1 1 100%;
+}
+
+@media (min-width: 30rem) {
+  .ctaRow > * {
+    flex: 0 0 auto;
+  }
+}
+
+.cta {
+  min-width: 11rem;
+}
+
+.promises {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2) var(--space-5);
+  padding: 0;
+  list-style: none;
+  color: var(--color-text-muted);
+  font-size: var(--text-sm);
+  font-weight: var(--weight-semibold);
+}
+
+.promises li {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-2);
+}
+
+.promises svg {
+  color: var(--color-secondary);
+}
+
+/* Decorative stack of cards. Sized in relation to its own column. */
+.heroArt {
+  position: relative;
+  justify-self: center;
+  width: min(100%, 22rem);
+  aspect-ratio: 1.1;
+}
+
+.artCard {
+  position: absolute;
+  display: grid;
+  place-items: center;
+  width: 58%;
+  aspect-ratio: 0.72;
+  border-radius: var(--radius-xl);
+  color: var(--color-tile-ink);
+  box-shadow: var(--shadow-lg);
+}
+
+.artCardBack {
+  top: 6%;
+  left: 4%;
+  background: var(--color-tile-5);
+  transform: rotate(-14deg);
+}
+
+.artCardMid {
+  top: 2%;
+  left: 22%;
+  background: var(--color-tile-3);
+  transform: rotate(-2deg);
+}
+
+.artCardFront {
+  top: 12%;
+  right: 2%;
+  background: var(--color-tile-1);
+  transform: rotate(11deg);
+}
+
+.artCorner {
+  position: absolute;
+  top: 8%;
+  left: 12%;
+  font-family: var(--font-display);
+  font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
+  font-weight: var(--weight-heavy);
+  line-height: 1;
+}
+
+/* Five-pip dice face. */
+.pips {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  grid-template-rows: repeat(3, 1fr);
+  width: 58%;
+  aspect-ratio: 1;
+}
+
+.pips span {
